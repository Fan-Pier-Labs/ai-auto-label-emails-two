{
  "name": "auto-label-email-ai",
  "version": "1.0.0",
  "description": "Auto label emails with AI - Next.js app with Gemini AI",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "bun:dev": "bun --bun next dev",
    "bun:build": "bun --bun next build",
    "bun:start": "bun --bun next start",
    "get-token": "bun run scripts/get-refresh-token.ts",
    "process-emails": "bun run scripts/run-processor.ts",
    "test-email": "bun run scripts/run-processor.ts --test",
    "test": "bun test $(find lib -name '*.test.ts' ! -name '*.network.test.ts')",
    "test:network": "bun test $(find . -name '*.network.test.ts')",
    "test:all": "bun test",
    "deploy": "bun run build && python3 ./node_modules/deploy/main.py --config deploy.yaml"
  },
  "dependencies": {
