# Gemini AI API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail OAuth Credentials (Required for web OAuth flow)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application type)
# Add authorized redirect URI: https://yourdomain.com/api/auth/gmail/callback
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here

# Gmail OAuth Refresh Token (Required for background email processing)
# Client ID and Secret are loaded from google_creds.json
# Run: bun run get-token to get your refresh token
RYANS_GMAIL_REFRESH_TOKEN=your_refresh_token

# Google Sheets (Optional - for loading rules from a spreadsheet)
# Make sure the sheet is publicly viewable
# Template: https://docs.google.com/spreadsheets/d/1oRvLEi2uj0ENbJ42EyINLzWcbC92HwGriMq5ejKhXYM/edit
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
# Or just the ID:
# GOOGLE_SHEETS_ID=YOUR_SPREADSHEET_ID

# Gmail Watch (Optional - for real-time push notifications)
# Full Pub/Sub topic name, e.g. projects/my-project-id/topics/gmail-watch
# Create the topic in Google Cloud, grant gmail-api-push@system.gserviceaccount.com
# publish permission, and add a push subscription to https://yourdomain.com/api/webhooks/gmail
# See docs/gmail-watch-setup.md for one-time GCP setup.
# GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-watch

# Push authentication (required for Gmail webhook when using OIDC on the push subscription)
# Full webhook URL; must match the endpoint URL configured on the Pub/Sub push subscription.
# GMAIL_WEBHOOK_AUDIENCE=https://yourdomain.com/api/webhooks/gmail
# Service account email that sends the push (OIDC token email claim), e.g. pubsub-push-auth@<PROJECT_ID>.iam.gserviceaccount.com
# GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push-auth@your-gcp-project.iam.gserviceaccount.com

# Stripe Configuration (Required for payment processing)
# Get these from Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Price ID for the subscription product (from Stripe Dashboard Products)
STRIPE_PRICE_ID=price_your_price_id_here
# Webhook secret from Stripe Dashboard: https://dashboard.stripe.com/webhooks
# Add endpoint: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Encryption key for gmail_refresh_token in Stripe customer metadata (32 bytes as hex).
# Only the refresh token is encrypted; gmail_email and google_sheet_id are stored plaintext.
# Generate with: openssl rand -hex 32
STRIPE_METADATA_ENCRYPTION_KEY=your_64_character_hex_key_here

# Processing Configuration (Optional)
POLL_INTERVAL_MINUTES=5
PROCESSED_LABEL=__auto-processed__
DRY_RUN=false


# Sentry Configuration (Optional - for error tracking and session replay)
# Get your DSN from https://sentry.io/settings/{org}/projects/{project}/keys/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Optional: For source map uploads during build
SENTRY_ORG=your_org_name_here
SENTRY_PROJECT=your_project_name_here
SENTRY_AUTH_TOKEN=your_auth_token


# The URL of the app. This is used to redirect the user after the oauth flow.
NEXT_APP_URL=http://localhost:8080


# Template sheet URL (Required for the setup form)
NEXT_TEMPLATE_SHEET_URL="your_template_sheet_url_here"
